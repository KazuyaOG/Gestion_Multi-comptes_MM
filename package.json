{
  "name": "gestion-multi-comptes-mm",
  "version": "1.0.0",
  "description": "Application Windows simple et minimaliste pour gérer plusieurs comptes (courriel, finance, social) et ses sites favoris.",
  "main": "src/main.js",
  "author": "MM",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "apercu": "node tools/apercu.mjs",
    "dist": "electron-builder --win",
    "portable": "electron-builder --win portable",
    "installateur": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ca.mm.gestionmulticomptes",
    "productName": "Gestion Multi-comptes",
    "copyright": "© MM",
    "directories": {
      "output": "dist",
      "buildResources": "ressources"
    },
    "files": [
      "src/**/*",
      "ressources/icone.ico",
      "ressources/icone.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "ressources/icone.ico",
      "artifactName": "Gestion-Multi-comptes-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gestion Multi-comptes",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "artifactName": "Gestion-Multi-comptes-Installation-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Gestion-Multi-comptes-Portable-${version}.${ext}"
    }
  }
}
